<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🔐 ACCESO A AJUSTES</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background: #000;
            color: #0f0;
            font-family: monospace;
            text-align: center;
            padding: 20px;
            font-size: 16px;
            line-height: 1.6;
        }
        h1 { font-size: 20px; margin-bottom: 15px; }
        .caja {
            border: 2px solid #0f0;
            padding: 18px;
            border-radius: 12px;
            margin: 15px auto;
            max-width: 400px;
        }
        .boton {
            background: #0f0;
            color: #000;
            font-size: 15px;
            font-weight: bold;
            padding: 10px 14px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            margin: 5px 3px;
            font-family: monospace;
        }
        .boton:hover { background: #0c0; }
        .b-azul { background: #0088ff; color: #fff; }
        .b-azul:hover { background: #0066cc; }
        .b-naranja { background: #ff8800; color: #000; }
        .b-naranja:hover { background: #cc6600; }
        .fila { display: flex; flex-wrap: wrap; justify-content: center; }
        .oculto { display: none; }
        .activo { animation: parpadeo 1s infinite; }
        @keyframes parpadeo {
            0% { opacity: 1; }
            50% { opacity: 0.3; }
            100% { opacity: 1; }
        }
        small { color: #080; }
    </style>
</head>
